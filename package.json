{
  "name": "copyboard",
  "version": "0.0.0-foundation-a",
  "private": true,
  "type": "module",
  "description": "CopyBoard — local-first clipboard workspace. Legacy ESM app plus Vite/TypeScript foundation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jszip": "3.10.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages-preview": "vite build --mode pages-preview",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.legacy.json",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:unit": "vitest run",
    "test:smoke": "npm run build && node scripts/e2e.mjs smoke",
    "test:smoke:dev": "node scripts/e2e.mjs smoke --target=dev",
    "test:pages-preview": "npm run build:pages-preview && node scripts/check-pages-preview.mjs",
    "test:e2e:full": "npm run build && node scripts/e2e.mjs full",
    "test": "npm run check:syntax && npm run typecheck && npm run test:unit",
    "ci": "npm run test && npm run test:smoke",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
